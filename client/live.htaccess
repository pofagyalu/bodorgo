# A copy of the live site's .htaccess (W:/bodorgo/.htaccess), kept here so it
# is not lost: that file is on the web server only - the deploy (sync.js)
# leaves it where it is and never copies this one. After changing it there,
# copy it here too. (This header is not in the live file.)
#
# What it does: the single-page app's rewrite to index.html, compression
# (gzip for what the server's default leaves out, Brotli from the .br copies
# deploy-build.js makes), and how long a browser may keep each kind of file.

# Enable basic rewrite engine (used by most PHP apps)
RewriteEngine On

# Redirect all HTTP traffic to HTTPS
#RewriteCond %{HTTPS} off
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Default file to serve
DirectoryIndex index.html

# Simple security tweaks
<FilesMatch "\.(htaccess|htpasswd|ini|env)$">
  Require all denied
</FilesMatch>

# Optional: custom 404 error page
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite everything else to index.html
  RewriteRule ^.*$ /index.html [L]
</IfModule>


# --- Compression (added 2026-10-03) ---
# Text is compressed on its way out. gzip was on already for HTML, CSS and
# JS (the server's own default); these add what that leaves out - SVG
# images, JSON, the web manifest, TTF fonts.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE image/svg+xml application/json application/manifest+json font/ttf application/x-font-ttf
</IfModule>
# Brotli - smaller than gzip - for the browsers that ask for it, if this
# server has the module (skipped without it).
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml font/ttf application/x-font-ttf
</IfModule>

# --- Caching (added 2026-10-03) ---
# (Each pattern also takes the file's Brotli copy, ".br" - see below.)
<IfModule mod_headers.c>
  # Pictures and fonts under their own names (assets/): kept for an hour.
  <FilesMatch "\.(svg|png|jpe?g|webp|gif|ico|woff2?|ttf|otf)(\.br)?$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # The build's files carry a code of their content in their name
  # (main-GMG3L7X6.js, media/Poppins-Bold-NEESVN2L.woff2): a changed file
  # has a new name, so these never change - kept for a year, never asked
  # for again.
  <FilesMatch "-[A-Z0-9]{8}\.(js|css|woff2?|ttf|otf|svg|png|jpe?g|webp|gif)(\.br)?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The page itself, its version, the manifest and the service worker say
  # which files are the current ones: always asked for afresh.
  <FilesMatch "^(index\.html|version\.json|manifest\.webmanifest|sw\.js)(\.br)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Brotli, from ready-made copies (added 2026-10-03) ---
# This server has no Brotli module, so the deploy makes a .br copy of every
# script, stylesheet and SVG (client/deploy-build.js). A browser that says
# it takes Brotli gets that copy - about a tenth smaller than gzip; the
# others get the file itself, gzipped as before.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Encoding} \bbr\b
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+\.(?:js|css|svg))$ $1.br [L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg)\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>
# What the copy is, under its .br: the type of the file it was made of -
# and it is not to be gzipped on top.
<FilesMatch "\.js\.br$">
  ForceType text/javascript
</FilesMatch>
<FilesMatch "\.css\.br$">
  ForceType text/css
</FilesMatch>
<FilesMatch "\.svg\.br$">
  ForceType image/svg+xml
</FilesMatch>
<IfModule mod_env.c>
  <FilesMatch "\.br$">
    SetEnv no-gzip 1
  </FilesMatch>
</IfModule>
