# Settings of the Docker setup (compose.yaml). Copy this file to .env, next
# to compose.yaml, and fill it in. That file is never committed.
#
# The app's own settings (logins, e-mail, payments...) are not here: they
# are in server/.env, made from server/src/.env.example.

# --- The database -----------------------------------------------------------
# The database container's own user, made the first time it starts. Use
# letters and numbers only in the password (it becomes part of an address).
MONGO_ROOT_USER=bodorgo
MONGO_ROOT_PASSWORD=
MONGO_DB=bodorgo

# --- The database copy to start from -----------------------------------------
# A folder holding one `mongodump --archive --gzip` file. It is loaded once,
# when the database is still empty; later starts don't touch it.
DUMP_DIR=./handover/db
# Which database of the copy to take (a backup may hold several).
DUMP_DB=bodorgo
# Collections left out, separated by spaces. "sessions": the old place's
# logins. For a try-out beside the live site add pushsubscriptions too, so
# the copy can't send notifications to people's phones:
#DUMP_SKIP=sessions pushsubscriptions
DUMP_SKIP=sessions

# --- Addresses ----------------------------------------------------------------
# The ports on this machine. The HTTPS reverse proxy points the site's
# address at WEB_PORT and the API's address at API_PORT.
WEB_PORT=8080
API_PORT=8235
# The API's address as browsers reach it. It is written into the website
# when its image is built: after changing it, rebuild (docker compose build web).
PUBLIC_API_URL=http://localhost:8235

# --- Photos and videos on this machine (read only) -----------------------------
# Tour photos: one folder per tour.
PHOTOS_DIR=./handover/files/photos
# Média → Fotók: one folder per category.
MEDIA_PHOTOS_DIR=./handover/files/media-photos
# Videos: one folder per series; "a-bodorgo-klan" holds the tours' videos.
VIDEOS_DIR=./handover/files/videos
# What the server makes out of them, and writes: thumbnails, the photos'
# smaller sizes, the videos' small copies. Bring the old server's
# thumbnails folder here and nothing has to be made again.
THUMBNAILS_DIR=./handover/files/thumbnails

# --- Optional -----------------------------------------------------------------
# The weather forecast's OpenWeatherMap key (built into the website).
OPENWEATHER_API_KEY=
# The version the app shows: the commit the images are built from and its
# date. See the README for the two git commands that give them.
BUILD_COMMIT=
BUILD_DATE=
