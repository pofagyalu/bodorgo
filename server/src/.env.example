NODE_ENV=development
PORT=8000
DB_URI=mongodb://<user>:<password>@localhost:27017/your_db_name?authSource=admin
REGISTER_REDIRECT_URL=http://localhost:3000/confirm
RESET_REDIRECT_URL=http://localhost:3000/reset

JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=your-jwt-expiry-time-in-days
JWT_COOKIE_EXPIRES_IN=days

MAILTRAP_EMAIL_USERNAME=your-email
MAILTRAP_EMAIL_PASSWORD=your-password
MAILTRAP_EMAIL_HOST=your-host
MAILTRAP_EMAIL_PORT=2525
MAILTRAP_EMAIL_FROM=your-sender-email

REDIS_URL=redis://localhost:26379

SENDGRID_USERNAME=your-sendgrid-username
SENDGRID_PASSWORD=your-sendgrid-password

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-public-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
# A second Stripe account for the tour advances (the first one is the
# club's, for membership dues) - a Stripe account pays out to one bank
# account. Left out, advances go to the first account too.
STRIPE_TOUR_SECRET_KEY=
STRIPE_TOUR_WEBHOOK_SECRET=

# Second payment gateway (see utils/barion.js) - currently the only one
# actually offered on the client (Stripe stays fully wired server-side,
# just not shown as a choice for now). POSKey comes from a Barion
# account's Shop admin page (barion.com/wallet -> Shops) - must be a
# registered Shop, not a personal wallet, or there's no POSKey at all.
# Sandbox (api.test.barion.com) by default; set BARION_ENV=production for
# the real barion.com API + a live POSKey.
BARION_POS_KEY=your-barion-pos-key
# Legacy single payee - still used as the fallback for both purposes below
# until their own dedicated *_PAYEE_EMAIL is set (see config.js).
BARION_PAYEE_EMAIL=your-barion-account-email

# Membership dues and tour advances are collected into two SEPARATE Barion
# wallets (config.js's barion.membership/.tour) - one Shop/POSKey above can
# still route each transaction to either one just by naming a different
# Payee email. WALLET_KEY/WITHDRAW_NAME/WITHDRAW_IBAN are only used by the
# admin-triggered withdrawal feature (paymentController.js's withdrawFunds)
# - WALLET_KEY is that wallet's own API key (from ITS OWN dashboard, not
# the Shop's POSKey above), needed to pull money out via Barion's
# /v3/Withdraw/BankTransfer. These only work with a real, live (non-
# sandbox) Barion wallet - a sandbox wallet has no real money to withdraw.
BARION_MEMBERSHIP_PAYEE_EMAIL=your-membership-wallet-email
BARION_MEMBERSHIP_WALLET_KEY=your-membership-wallet-api-key
BARION_MEMBERSHIP_WITHDRAW_NAME=account-holder-name-on-destination-account
BARION_MEMBERSHIP_WITHDRAW_IBAN=destination-iban

BARION_TOUR_PAYEE_EMAIL=your-tour-advance-wallet-email
BARION_TOUR_WALLET_KEY=your-tour-advance-wallet-api-key
BARION_TOUR_WITHDRAW_NAME=account-holder-name-on-destination-account
BARION_TOUR_WITHDRAW_IBAN=destination-iban

AUTHENTIK_SERVER_URL=https://oridzs.terfotozas.hu
AUTHENTIK_CLIENT_ID=YOUR_CLIENT_ID_HERE
AUTHENTIK_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
AUTHENTIK_REDIRECT_URI=https://api.bodorgo.hu/auth/callback
AUTHENTIK_PROVIDER_SLUG=bodorgo   # change if you used a different slug
AUTHENTIK_POSTLOGOUT_URI=https://bodorgo.hu/
COOKIE_SECRET=some-long-random-string

# Absolute URL of the Angular client (client and server are on different
# subdomains in prod, so this must be a full origin, not a relative path)
CLIENT_BASE_URL=https://bodorgo.hu/
# Comma-separated list of origins allowed to make credentialed requests
CLIENT_ORIGIN=https://bodorgo.hu,http://localhost:4200

# This server's own public base URL - Barion needs it on every payment
# start request (see utils/barion.js), unlike Stripe which has no
# per-request callback URL at all (configured once in its own dashboard).
API_BASE_URL=https://api.bodorgo.hu/

# Free tier at openrouteservice.org - used to compute each tour's real
# driving distance from Budapest (cached on the Tour document, only
# recomputed when its coordinates change - see utils/distance.js)
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key

# Tour photo gallery (see tour-photos-implementation-plan.md). The two
# environments need different path forms for the same underlying NAS
# storage - the values below are the production (S:\bodorgo\.env) form,
# real NAS-absolute paths. Running scripts/syncTourImages.js by hand from
# a dev machine instead needs the Windows-mapped-drive form in THIS local
# .env file, e.g. PHOTOS_ROOT=Z:/bódorgó_táborok and
# THUMBNAILS_ROOT=S:/bodorgo/thumbnails.
PHOTOS_ROOT=/volume1/photo/bódorgó_táborok
THUMBNAILS_ROOT=/volume2/server/bodorgo/thumbnails

# Post-tour recap videos (see tourVideoController.js) - the existing
# Jellyfin library on the NAS, streamed straight from there rather than
# copied anywhere. Same production-vs-dev path split as above; a dev
# machine's local .env needs the Windows-mapped-drive form instead, e.g.
# VIDEOS_ROOT=Y:/sorozatok/A bódorgó klán.
VIDEOS_ROOT=/volume1/video/sorozatok/A bódorgó klán

# Local .env only - every e-mail goes to this address instead of the real
# recipients (the dev database is a copy of production). Never on the live server.
EMAIL_REDIRECT_TO=you@example.com

# Média → Fotók: the NAS folder whose subfolders are the photo categories
# (live: /volume1/photo/bódorgó_egyéb, a dev machine: its mapped drive).
MEDIA_PHOTOS_ROOT=/volume1/photo/bódorgó_egyéb
