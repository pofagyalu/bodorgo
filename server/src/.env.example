# The server's settings. Copy this file to server/.env (next to
# package.json) and fill it in. That file is never committed.
#
# Every name the server reads is here (src/config.js reads them); anything
# else in an old .env does nothing. The first block is needed to start and
# log in - each later block only for its own feature, and can stay empty.
#
# Running in Docker (see the root README, "Running it in Docker"): the same
# file is used. The lines marked [Docker sets this] are then set by
# compose.yaml and whatever is written here for them is ignored.

# ---------------------------------------------------------------------------
# Needed to start and log in
# ---------------------------------------------------------------------------

# "development" on your own machine, "production" on a live server: an
# HTTPS-only session cookie and no error details sent to the browser. With
# "production" the site has to be reached over HTTPS, or nobody stays
# logged in.
NODE_ENV=development

# The port the API listens on. The client's development settings expect
# 8235 (client/src/environments/environment.development.ts).
# [Docker sets this]
PORT=8235

# MongoDB, with the database's name in it. Sessions are kept in the same
# database. A password with special characters must be URL-encoded.
# [Docker sets this]
DB_URI=mongodb://<user>:<password>@localhost:27017/bodorgo-dev?authSource=admin

# Signs the session cookie. A long random string; changing it logs
# everybody out.
COOKIE_SECRET=

# Encrypts the secrets kept in the database (the OIDC client secret, the
# Authentik API token - set in the app, on Klub → Beállítások → OIDC
# szolgáltató). A long random string. Keep it with the database's backups:
# a database restored on a server with another key can't read those secrets,
# and they have to be typed in again.
APP_SECRET_KEY=

# Authentik: the OAuth2/OpenID provider of the Bódorgó application.
# These are set in the app (Klub → Beállítások → OIDC szolgáltató, the role
# manager only) and kept in the database, the secrets encrypted. The lines
# here are only for getting started: the first start (with APP_SECRET_KEY
# set) copies them into the database. Once you can log in and the tab shows
# them, DELETE these lines - nothing reads them any more. (A brand-new
# installation can skip them altogether: get in with the emergency login
# below and type them in on the tab.)
# The API's own /auth/callback must be listed among the provider's Redirect
# URIs.
AUTHENTIK_SERVER_URL=https://auth.example.org
AUTHENTIK_PROVIDER_SLUG=bodorgo
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Where a logout lands: the client.
AUTHENTIK_POSTLOGOUT_URI=http://localhost:4200

# The client's full address - where the API sends people after login, and
# what links in e-mails and on the Futókör cards point at.
CLIENT_BASE_URL=http://localhost:4200/
# Who may call the API from a browser: the client's origin(s), comma-separated.
CLIENT_ORIGIN=http://localhost:4200
# This API's own public address (Barion calls it back after a payment).
API_BASE_URL=http://localhost:8235/

# The role manager's e-mail: the one admin who may change roles. Checked at
# every start; changing it hands the app over. If nobody has this e-mail
# yet, that person's first login creates their account, as admin.
INITIAL_ADMIN_USER=you@example.org

# EMERGENCY LOGIN - when nobody can log in through the OIDC provider
# (Authentik is gone or broken, the app was restored somewhere else, or
# wrong settings were saved on Klub → Beállítások → OIDC szolgáltató).
#
# Normally LOCAL_LOGIN=false: everybody logs in through the provider, and
# INITIAL_ADMIN_PASSWORD does nothing (it can stay here).
#
# What to do in an emergency:
#  1. Set INITIAL_ADMIN_USER (above) to your e-mail and
#     INITIAL_ADMIN_PASSWORD to a long random password (at least 12
#     characters, letters and digits) - if they aren't already.
#  2. Set LOCAL_LOGIN=true and restart the server.
#  3. Open the site: the login page now asks for an e-mail and a password.
#     Log in with the two values above. You are the admin with every right;
#     nobody else can log in meanwhile.
#  4. Klub → Beállítások → OIDC szolgáltató: enter the (new) provider's
#     Server URL, Provider slug, Client ID and Client secret, and save. In
#     the provider, list this API's /auth/callback and the Logout URI among
#     the Redirect URIs.
#  5. Set LOCAL_LOGIN=false and restart. Everybody logs in through the
#     provider again; people are matched by their e-mail, so their accounts
#     and data are as before.
#  If step 5 doesn't work, go back to step 2 and check the settings.
#
# The app never stores or changes this password: it is only ever this line.
LOCAL_LOGIN=false
INITIAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Invitations (Klub → Felhasználók → Meghívók)
# ---------------------------------------------------------------------------

# The token of the Authentik service account that may create invitations.
# Set in the app too (Beállítások → OIDC szolgáltató) - used from here as
# the Authentik lines above are.
AUTHENTIK_API_TOKEN=
# Only if the invitation flow's slug is not "enrollment-invitation".
#AUTHENTIK_INVITATION_FLOW=enrollment-invitation

# ---------------------------------------------------------------------------
# E-mail (Resend)
# ---------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_EMAIL_FROM=Bódorgó <no-reply@example.org>
# Your own machine only: every e-mail goes to this address instead of the
# real people (a development database is a copy of the live one).
# NEVER on a live server.
#EMAIL_REDIRECT_TO=you@example.org

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------

# One key pair, made once (npx web-push generate-vapid-keys) and never
# changed: a phone that switched notifications on can only be reached with
# the pair it was given. Without them push is simply off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://example.org

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# Stripe, the club's account: membership fees. Without the key that
# payment's Stripe button is greyed out.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe, a second account: tour advances (a Stripe account pays out to one
# bank account). Without these, advances cannot be paid by Stripe.
STRIPE_TOUR_SECRET_KEY=
STRIPE_TOUR_WEBHOOK_SECRET=

# Barion: the shop's POSKey. The sandbox (api.test.barion.com) unless
# BARION_ENV=production.
BARION_POS_KEY=
#BARION_ENV=production
# Each wallet's own API key - only for withdrawing from it. Where the money
# lands (the wallets' e-mails, the bank accounts) is set in the app, on
# Klub → Beállítások.
BARION_MEMBERSHIP_WALLET_KEY=
BARION_TOUR_WALLET_KEY=

# ---------------------------------------------------------------------------
# Photos and videos: folders on this machine's disk
# ---------------------------------------------------------------------------
# The path as THIS machine sees it: a server on the NAS needs the real path
# (/volume1/photo/...), a Windows machine its mapped drive (Z:/...).
# [Docker sets all of these]

# Tour photos: one folder per tour, named ..._bodorgo_<roman numeral>.
PHOTOS_ROOT=/volume1/photo/bódorgó_táborok
# Thumbnails and other pictures the server makes itself. It writes here.
THUMBNAILS_ROOT=/volume2/server/bodorgo/thumbnails
# Média → Fotók: each subfolder is a category.
MEDIA_PHOTOS_ROOT=/volume1/photo/bódorgó_egyéb
# The videos: one subfolder per series; "a-bodorgo-klan" holds the tours'
# recap videos.
MEDIA_ROOT=/volume1/video/sorozatok
# Only if the two kinds of video are not under one folder:
#VIDEOS_ROOT=
#MEDIA_VIDEOS_ROOT=

# ---------------------------------------------------------------------------
# Music (Jellyfin)
# ---------------------------------------------------------------------------

JELLYFIN_URL=
JELLYFIN_API_KEY=
# One playlist's id each: Bódorgó FM, Buli, Duruzsoló.
JELLYFIN_PLAYLIST_ID=
JELLYFIN_BULI_PLAYLIST_ID=
JELLYFIN_HATTER_PLAYLIST_ID=
# Optional: whose view lists the playlists (by default Jellyfin's first user).
#JELLYFIN_USER_ID=
# Optional: where the songs' pictures are kept (by default THUMBNAILS_ROOT/_music).
#MUSIC_IMAGES_ROOT=

# ---------------------------------------------------------------------------
# Other features
# ---------------------------------------------------------------------------

# openrouteservice.org (free tier): a tour's driving distance from Budapest.
OPENROUTESERVICE_API_KEY=

# Futókör: signs the links on the printed cards. Set it BEFORE printing the
# cards and never change it - cards printed with another value stop
# working. (Without it the cookie secret stands in.)
FUTOKOR_TAG_SECRET=

# ---------------------------------------------------------------------------
# The live server only
# ---------------------------------------------------------------------------
# Leave both off everywhere else, or people get the same e-mail twice.

# The timed jobs: poll reminders, membership fee reminders.
#BACKGROUND_JOBS=on
# "Your tour's video is ready" e-mails after Új média felfedezése.
#TOUR_VIDEO_EMAILS=on

# ---------------------------------------------------------------------------
# Where uploads are kept - optional, the defaults are right
# ---------------------------------------------------------------------------
# By default under the folder the server is started from: documents/ and
# chat-images/. The automated tests point these at a temporary folder.
#CLUB_DOCUMENTS_DIR=
#RECEIPTS_DIR=
#GPX_DIR=
#QUIZ_IMAGES_DIR=
#CHAT_IMAGES_DIR=
