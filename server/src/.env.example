NODE_ENV=development
PORT=8000
DB_URI=mongodb://<user>:<password>@localhost:27017/your_db_name?authSource=admin
DB_TEST_URI=mongodb://<user>:<password>@localhost:27017/your_db_name-test?authSource=admin
REGISTER_REDIRECT_URL=http://localhost:3000/confirm
RESET_REDIRECT_URL=http://localhost:3000/reset

JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=your-jwt-expiry-time-in-days
JWT_COOKIE_EXPIRES_IN=days

MAILTRAP_EMAIL_USERNAME=your-email
MAILTRAP_EMAIL_PASSWORD=your-password
MAILTRAP_EMAIL_HOST=your-host
MAILTRAP_EMAIL_PORT=2525
MAILTRAP_EMAIL_FROM=your-sender-email

REDIS_URL=redis://localhost:26379

SENDGRID_USERNAME=your-sendgrid-username
SENDGRID_PASSWORD=your-sendgrid-password

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-public-key

AUTHENTIK_SERVER_URL=https://oridzs.terfotozas.hu
AUTHENTIK_CLIENT_ID=YOUR_CLIENT_ID_HERE
AUTHENTIK_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
AUTHENTIK_REDIRECT_URI=https://api.bodorgo.hu/auth/callback
AUTHENTIK_PROVIDER_SLUG=bodorgo   # change if you used a different slug
AUTHENTIK_POSTLOGOUT_URI=https://bodorgo.hu/
COOKIE_SECRET=some-long-random-string

# Absolute URL of the Angular client (client and server are on different
# subdomains in prod, so this must be a full origin, not a relative path)
CLIENT_BASE_URL=https://bodorgo.hu/
# Comma-separated list of origins allowed to make credentialed requests
CLIENT_ORIGIN=https://bodorgo.hu,http://localhost:4200

# Free tier at openrouteservice.org - used to compute each tour's real
# driving distance from Budapest (cached on the Tour document, only
# recomputed when its coordinates change - see utils/distance.js)
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key

# Tour photo gallery (see tour-photos-implementation-plan.md). The two
# environments need different path forms for the same underlying NAS
# storage - the values below are the production (S:\bodorgo\.env) form,
# real NAS-absolute paths. Running scripts/syncTourImages.js by hand from
# a dev machine instead needs the Windows-mapped-drive form in THIS local
# .env file, e.g. PHOTOS_ROOT=Z:/bódorgó_táborok and
# THUMBNAILS_ROOT=S:/bodorgo/thumbnails.
PHOTOS_ROOT=/volume1/photo/bódorgó_táborok
THUMBNAILS_ROOT=/volume2/server/bodorgo/thumbnails
