{
  "name": "bodorgo_server",
  "version": "1.0.0",
  "description": "Bódorgó klub API szerver",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "build": "node build.js && node sync.js",
    "start": "nodemon src/server.js",
    "start:prod": "SET NODE_ENV=production&&nodemon src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore"
  },
  "author": "Zoltán Nagy",
  "license": "ISC",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "jose": "^6.1.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.2",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "openid-client": "^6.8.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "resend": "^6.28.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "stripe": "^22.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.23",
    "web-push": "^3.6.7",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
