*.env
public
config.env
dist/
logs/

# Auto-generated per-payment receipt PDFs (see paymentController.js) -
# unlike the rest of documents/ (real, permanent, admin-curated club
# records meant to be committed), these are per-environment dynamic data
# containing personal financial details, same "never committed, never
# synced between dev/prod" treatment as public/ - just physically nested
# under documents/ per the admin's own preferred folder layout.
documents/payments/

# One-off JSON files for scripts/addTour.js, scripts/addSchedule.js and
# scripts/importAttendance.js - working data, not permanent seed data,
# never needs committing.
scripts/input/*
!scripts/input/README.md
!scripts/input/example-tour.json
!scripts/input/example-events.json
!scripts/input/example-attendance.json