node_modules/
*.env
public
config.env
dist/
logs/

# Club documents uploaded through the Klub "Dokumentumok" page (invoices,
# contracts, founding papers...) and the auto-generated per-payment
# receipts under documents/payments/ - real club data, some of it
# financial/personal, never committed. They live on disk only: the
# uploads land here and are copied to production by sync.js (the local
# app and production share one database, so its records point at these
# files), except documents/payments/, which sync.js never copies.
documents/

# One-off JSON files for scripts/addTour.js, scripts/addSchedule.js and
# scripts/importAttendance.js - working data, not permanent seed data,
# never needs committing.
scripts/input/*
!scripts/input/README.md
!scripts/input/example-tour.json
!scripts/input/example-events.json
!scripts/input/example-attendance.json
# Test coverage report (npm run test:coverage) - generated, never committed.
coverage/
